DATABASE_URL="mysql://root:root@localhost:3307/attendance"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Photo storage (Cloudinary) -> attendance/<production|dev>/<employeeCode>/
CLOUDINARY_CLOUD_NAME="<cloud_name>"
CLOUDINARY_API_KEY="<api_key>"
CLOUDINARY_API_SECRET="<api_secret>"
# Optional: force "production" or "dev". Defaults to production on Vercel prod deploys, dev otherwise.
APP_ENV=dev
